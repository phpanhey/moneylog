# Zugangsdaten fuer get_token.sh
# Datei kopieren nach ".env" und Werte eintragen:
#   cp .env.example .env
# Danach vor dem Aufruf laden:
#   set -a && source .env && set +a && ./get_token.sh

# OAuth2 Client-Zugangsdaten (comdirect Entwicklerportal)
COMDIRECT_CLIENT_ID=
COMDIRECT_CLIENT_SECRET=

# Zugangsdaten zum comdirect-Konto
COMDIRECT_ZUGANGSNUMMER=
COMDIRECT_PIN=
